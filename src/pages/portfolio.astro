---
import Layout from '../layouts/Layout.astro';
import VideosVirais from '../components/VideosVirais.astro';
import ParedeDeRostos from '../components/ParedeDeRostos.astro';
import Icon from '../components/Icon.astro';

const cases = [
  {
    img: '/assets/case-1.webp',
    alt: 'Aumento de 1907% nas visualizações e 1527% na receita com otimização SEO Aprimarus',
    stats: [
      { icon: 'trend-up', label: '+1.907% Visualizações' },
      { icon: 'currency-circle-dollar', label: '+1.527% Receita' },
    ],
  },
  {
    img: '/assets/case-2.webp',
    alt: 'Estratégia de retenção no YouTube gerando aumento de 184% nas views - Aprimarus',
    stats: [
      { icon: 'trend-up', label: '+184% Visualizações' },
      { icon: 'trend-up', label: '+125% Retenção' },
    ],
  },
  {
    img: '/assets/case-3.webp',
    alt: 'Crescimento acelerado de 4480% em inscritos através de vídeos otimizados - Aprimarus',
    stats: [
      { icon: 'trend-up', label: '+390% Visualizações' },
      { icon: 'trend-up', label: '+4.480% Inscritos' },
    ],
  },
];

const depoimentos = [1, 2, 3, 4, 5, 6].map((n) => ({
  img: `/assets/depoimento-${n}.webp`,
  alt: `Depoimento de cliente ${n} sobre os resultados da Agência Aprimarus no YouTube`,
}));

const thumbs = [
  { n: 1, alt: 'Exemplo de thumbnail otimizada para YouTube focada em alta taxa de clique (CTR)' },
  { n: 2, alt: 'Design de capa de vídeo estratégica criada pela Aprimarus para infoprodutores' },
  { n: 3, alt: 'Criação visual de thumbnail de alto impacto para viralização de vídeo' },
  { n: 4, alt: 'Thumbnail de YouTube projetada para conversão e cliques' },
  { n: 5, alt: 'Capa de YouTube profissional com gatilhos de curiosidade criados pela agência' },
  { n: 6, alt: 'Thumbnail estratégica para vídeos longos e aumento de audiência orgânica' },
].map((t) => ({ img: `/assets/thumb-${t.n}.webp`, alt: t.alt }));

const videosLongos = [
  { id: 'q59LAiymIzE', title: 'Edição de Vídeo Profissional para Retenção - Aprimarus' },
  { id: 'Zr8NGnJLD8w', title: 'Serviço de Edição Estratégica para YouTube' },
  { id: 'PocAoRvBO7E', title: 'Case de Edição para Infoprodutores' },
  { id: 'NHsTSkejUu4', title: 'Portfólio de Edição de YouTube - Retenção Alta' },
  { id: '5HOKciiqi-I', title: 'Aprimarus Agência - Exemplo de Vídeo Editado' },
  { id: 'y8R2VtmXoqs', title: 'Edição de Conteúdo Educacional no YouTube' },
  { id: 'vaTiImEVAC0', title: 'Vídeo Estratégico para Canal de YouTube' },
  { id: 'dApc8Km07EU', title: 'Corte e Edição de Vídeo com SEO' },
];

const shorts = [
  { id: 'AtJLbWa_nfQ', title: 'Edição Dinâmica para YouTube Shorts' },
  { id: 'kTNSw6_13y8', title: 'YouTube Shorts otimizado para retenção - Aprimarus' },
  { id: 'tQ7-Wds7jdk', title: 'Exemplo de Short Viral Editado Profissionalmente' },
  { id: 'PzNN4ZcCPXI', title: 'Edição Vertical Rápida para Infoprodutores' },
  { id: '578XSD_Etvk', title: 'Corte Estratégico de Short para YouTube' },
  { id: 'QKKB0VFh-EI', title: 'Gestão de Shorts e Conteúdo Vertical' },
  { id: 'QaBuGJSq4Bc', title: 'Edição de Shorts de Alto Desempenho' },
];

// uploadDate real não é conhecida para estes 15 vídeos, omitido em vez de inventado,
// já que uma data errada em dado estruturado arrisca desqualificação no rich result.
const videoSchema = [...videosLongos, ...shorts].map((v) => ({
  '@type': 'VideoObject',
  name: v.title,
  description: v.title,
  thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
  embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
}));
---
<Layout
  title="Portfólio - Cases, Vídeos e Depoimentos | Aprimarus"
  description="Veja os resultados reais, vídeos editados, thumbnails e depoimentos que a Aprimarus construiu em mais de 25 canais de infoprodutores no YouTube."
  extraSchema={[
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: videoSchema.map((v, i) => ({ '@type': 'ListItem', position: i + 1, item: v })),
    },
  ]}
>
  <main class="pt-28 pb-20">
    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-primary font-semibold text-sm md:text-base uppercase tracking-wider mb-4">Portfólio</p>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl uppercase mb-6 leading-tight">
          Resultados reais em mais de <span class="text-primary">25 canais</span>
        </h1>
        <p class="text-gray-700 text-lg max-w-3xl mx-auto">
          Cada case abaixo é validado pelo próprio YouTube Studio dos nossos clientes, sem achismo e sem número inflado. É o que acontece quando estratégia, edição e SEO trabalham juntos.
        </p>
      </div>

    </section>

    <VideosVirais />

    <section class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-3 gap-8 mb-20 mt-20">
        {cases.map((c) => (
          <div class="flex flex-col items-center">
            <img src={c.img} alt={c.alt} width="400" height="300" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full object-cover" />
            <div class="mt-4 flex flex-wrap justify-center gap-2 w-full">
              {c.stats.map((s) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name={s.icon} weight="bold" /> {s.label}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mb-20">
        <h2 class="font-display text-3xl sm:text-4xl uppercase mb-10 text-center text-foreground">O que nossos clientes dizem</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
          {depoimentos.map((d) => (
            <img src={d.img} alt={d.alt} width="400" height="400" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full object-cover" />
          ))}
        </div>
      </div>

      <div class="mb-20">
        <h2 class="font-display text-3xl sm:text-4xl uppercase mb-4 text-center text-foreground">Thumbnails que geram clique</h2>
        <p class="text-gray-700 text-lg max-w-2xl mx-auto text-center mb-10">Uma amostra das thumbnails que a Aprimarus produziu para clientes de nichos diferentes.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {thumbs.map((t) => (
            <img src={t.img} alt={t.alt} width="480" height="270" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full aspect-video object-cover" />
          ))}
        </div>
      </div>

      <div class="mb-20">
        <h2 class="font-display text-3xl sm:text-4xl uppercase mb-4 text-center text-foreground">Edições que retêm audiência</h2>
        <p class="text-gray-700 text-lg max-w-2xl mx-auto text-center mb-10">Vídeos longos editados pela Aprimarus, otimizados para manter o espectador assistindo.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {videosLongos.map((v) => (
            <button type="button" class="yt-fachada-pf group relative block w-full aspect-video rounded-xl overflow-hidden border border-border cursor-pointer"
                    data-id={v.id} aria-label={`Assistir: ${v.title}`}>
              <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" width="480" height="270" loading="lazy" decoding="async"
                   class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class="absolute inset-0 grid place-items-center bg-black/25 group-hover:bg-black/10 transition-colors">
                <span class="w-12 h-12 rounded-full bg-primary grid place-items-center shadow-elegant">
                  <Icon name="play" weight="fill" class="text-white text-xl ml-0.5" />
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="mb-20">
        <h2 class="font-display text-3xl sm:text-4xl uppercase mb-4 text-center text-foreground">YouTube Shorts</h2>
        <p class="text-gray-700 text-lg max-w-2xl mx-auto text-center mb-10">Cortes verticais de alta retenção produzidos para o feed de Shorts.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {shorts.map((v) => (
            <button type="button" class="yt-fachada-pf group relative block w-full aspect-[9/16] rounded-xl overflow-hidden border border-border cursor-pointer"
                    data-id={v.id} aria-label={`Assistir: ${v.title}`}>
              <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" width="270" height="480" loading="lazy" decoding="async"
                   class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class="absolute inset-0 grid place-items-center bg-black/25 group-hover:bg-black/10 transition-colors">
                <span class="w-12 h-12 rounded-full bg-primary grid place-items-center shadow-elegant">
                  <Icon name="play" weight="fill" class="text-white text-xl ml-0.5" />
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <ParedeDeRostos />

    <section class="max-w-6xl mx-auto px-6">
      <div class="text-center bg-soft border border-border rounded-2xl p-10 md:p-14 my-20">
        <h2 class="font-display text-2xl sm:text-3xl uppercase mb-4">Quer ser o próximo case?</h2>
        <p class="text-gray-600 mb-8 max-w-xl mx-auto">Preencha seus dados e vamos analisar se seu canal tem o perfil ideal para os nossos modelos de parceria.</p>
        <button type="button" onclick="openModal()" class="inline-flex items-center justify-center bg-primary text-white font-semibold px-8 py-4 rounded-md hover:bg-primary/90 transition-colors text-lg shadow-lg">
          Falar com a Aprimarus
        </button>
      </div>
    </section>
  </main>

  <script is:inline>
    document.querySelectorAll('.yt-fachada-pf').forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
        f.title = btn.getAttribute('aria-label');
        f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        f.allowFullscreen = true;
        f.className = 'absolute inset-0 w-full h-full';
        btn.replaceChildren(f);
        btn.classList.add('pointer-events-none');
      }, { once: true });
    });
  </script>
</Layout>

