---
import Layout from '../layouts/Layout.astro';
import Reveal from '../components/Reveal.astro';
import BarraCredibilidade from '../components/BarraCredibilidade.astro';
import ParedeDeRostos from '../components/ParedeDeRostos.astro';
import VideosVirais from '../components/VideosVirais.astro';
import RedesSociais from '../components/RedesSociais.astro';
import Icon from '../components/Icon.astro';

const depoimentos = [
  { img: '/assets/depoimento-5.webp', frase: 'Você simplesmente arrasou. Edição impecável.' },
  { img: '/assets/depoimento-4.webp', frase: 'Gostei demais dessa edição, ficou show.', nome: 'Marina Moretz' },
  { img: '/assets/depoimento-6.webp', frase: 'Gostei da sua postura, do seu trabalho e, principalmente, da sua garra.' },
];
---
<Layout
  title="Aprimarus · Gestão de canal no YouTube para infoprodutores e profissionais liberais"
  description="Você grava, a Aprimarus cuida de pauta, edição, thumbnail, SEO e publicação. Gestão completa de canal no YouTube para infoprodutores, médicos e advogados. A partir de R$ 3.000 por mês."
  extraSchema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Quanto custa a gestão de canal da Aprimarus?',
          acceptedAnswer: { '@type': 'Answer', text: 'Os planos começam em R$ 3.000 por mês e variam pela frequência de publicação. Não cobramos taxa de setup e não cobramos diagnóstico.' },
        },
        {
          '@type': 'Question',
          name: 'Preciso já ter canal no YouTube para contratar?',
          acceptedAnswer: { '@type': 'Answer', text: 'Não. Tem canal na nossa carteira que começou sem nenhum vídeo publicado, e tem canal que estava parado há anos e voltou a crescer.' },
        },
        {
          '@type': 'Question',
          name: 'Em quanto tempo aparece resultado?',
          acceptedAnswer: { '@type': 'Answer', text: 'Os primeiros vídeos vão ao ar na terceira semana. Movimento de busca costuma aparecer entre o segundo e o terceiro mês, porque o YouTube leva tempo para entender sobre o que é o canal.' },
        },
        {
          '@type': 'Question',
          name: 'A Aprimarus atende em espanhol?',
          acceptedAnswer: { '@type': 'Answer', text: 'Sim. A operação é bilíngue e tem base na Argentina.' },
        },
      ],
    },
  ]}
>
  <main class="block pt-20">

    <!-- 01 · HERO -->
    <section class="pt-16 pb-16 md:pb-24 bg-gradient-to-b from-soft to-background">
      <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row gap-10 items-center">
        <div class="w-full lg:w-1/2">
          <p class="text-primary font-semibold text-sm md:text-base uppercase tracking-wider mb-4">
            Para infoprodutores, médicos, advogados e profissionais que vivem do que sabem
          </p>
          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl uppercase mb-4 leading-none">
            <span class="sr-only">Agência de SEO para YouTube: </span>
            Você só grava. <br>
            <span class="text-primary">O resto é com a gente.</span>
          </h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            A Aprimarus assume o canal inteiro: pauta, gancho, edição, thumbnail, SEO e publicação. Você
            entra na frente da câmera, fala o que já sabe, e sai. O canal continua trabalhando depois que
            você desliga.
          </p>

          <ul class="space-y-3 mb-10">
            <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-1" /><span class="text-gray-800">Canal parado há meses? A gente estrutura e recoloca no ar.</span></li>
            <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-1" /><span class="text-gray-800">Já tentou com freelancer e não andou? O problema era não ter ninguém decidindo o tema.</span></li>
            <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-1" /><span class="text-gray-800">Não tem tempo nem equipe? É literalmente o serviço.</span></li>
            <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-1" /><span class="text-gray-800">Quer paciente, aluno ou cliente entrando pelo YouTube? É para isso que a gente existe.</span></li>
          </ul>

          <button type="button" onclick="openModal()" class="inline-flex items-center justify-center bg-primary text-white font-semibold px-8 py-4 rounded-md hover:bg-primary/90 transition-colors text-lg shadow-lg">
            Quero o diagnóstico do meu canal
          </button>
        </div>

        <div class="w-full lg:w-1/2 relative">
          <img src="/assets/depois.webp" alt="Gráfico de crescimento de canal com a Agência Aprimarus - Aumento de visualizações e retenção" width="900" height="503" fetchpriority="high" decoding="async" class="w-full h-auto rounded-2xl shadow-elegant border border-gray-200 object-contain">
          <div class="mt-4 flex flex-wrap justify-center lg:justify-start gap-3 w-full">
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-growth-bg text-growth font-bold text-sm">
              <Icon name="trend-up" weight="bold" /> +184% Visualizações
            </span>
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-growth-bg text-growth font-bold text-sm">
              <Icon name="trend-up" weight="bold" /> +125% Retenção
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · BARRA DE CREDIBILIDADE -->
    <BarraCredibilidade />

    <!-- 03 · PAREDE DE ROSTOS -->
    <Reveal><ParedeDeRostos /></Reveal>

    <!-- 04 · VÍDEOS QUE VIRALIZARAM -->
    <Reveal><VideosVirais /></Reveal>

    <!-- 05 · CONCORRENTE SENDO ENCONTRADO -->
    <Reveal as="section" class="py-16 md:py-24 bg-foreground text-background">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-center uppercase mb-6 leading-tight">
          Enquanto você não está no YouTube,<br />
          <span class="text-white">seu concorrente está sendo encontrado no seu lugar.</span>
        </h2>
        <p class="text-center text-gray-300 text-lg mb-12">
          Cada semana sem conteúdo estratégico é uma semana de buscas que não te encontram. O YouTube não esquece quem aparece. E não perdoa quem some.
        </p>

        <div class="overflow-hidden rounded-2xl border border-gray-800 grid grid-cols-2">
          <div class="p-5 md:p-6 bg-gray-900 font-semibold text-gray-300 uppercase text-xs md:text-sm tracking-wider">Sem a Aprimarus</div>
          <div class="p-5 md:p-6 bg-primary text-white font-semibold uppercase text-xs md:text-sm tracking-wider">Com a Aprimarus</div>

          <div class="p-5 border-t border-gray-800 flex gap-3"><Icon name="x" class="text-gray-500 mt-1 flex-shrink-0" /><span class="text-gray-200 text-sm">Posta sem SEO, ninguém acha</span></div>
          <div class="p-5 border-t border-gray-800 bg-gray-900 flex gap-3"><Icon name="check" weight="bold" class="text-primary mt-1 flex-shrink-0" /><span class="text-white text-sm">Cada vídeo posicionado nas buscas</span></div>

          <div class="p-5 border-t border-gray-800 flex gap-3"><Icon name="x" class="text-gray-500 mt-1 flex-shrink-0" /><span class="text-gray-200 text-sm">Vídeo some em dias</span></div>
          <div class="p-5 border-t border-gray-800 bg-gray-900 flex gap-3"><Icon name="check" weight="bold" class="text-primary mt-1 flex-shrink-0" /><span class="text-white text-sm">Vídeo aparece nas buscas por anos</span></div>

          <div class="p-5 border-t border-gray-800 flex gap-3"><Icon name="x" class="text-gray-500 mt-1 flex-shrink-0" /><span class="text-gray-200 text-sm">Sem dados, sem direção</span></div>
          <div class="p-5 border-t border-gray-800 bg-gray-900 flex gap-3"><Icon name="check" weight="bold" class="text-primary mt-1 flex-shrink-0" /><span class="text-white text-sm">Análise mensal de performance real</span></div>

          <div class="p-5 border-t border-gray-800 flex gap-3"><Icon name="x" class="text-gray-500 mt-1 flex-shrink-0" /><span class="text-gray-200 text-sm">3 profissionais para coordenar</span></div>
          <div class="p-5 border-t border-gray-800 bg-gray-900 flex gap-3"><Icon name="check" weight="bold" class="text-primary mt-1 flex-shrink-0" /><span class="text-white text-sm">Um único ponto de contato</span></div>
        </div>
      </div>
    </Reveal>

    <!-- 06 · ESSE SERVIÇO É PARA VOCÊ SE -->
    <Reveal as="section" class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase text-center mb-4">Se você se reconhece em duas dessas, a gente resolve</h2>
        <div class="w-16 h-1 bg-primary mx-auto mb-12"></div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="heartbeat" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Você atende bem, seus pacientes ou alunos te elogiam, e mesmo assim ninguém novo te encontra.</p></div>
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="film-strip" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Você já gravou vídeo bom que morreu com 200 views porque ninguém pensou em título e capa.</p></div>
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="users-three" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Você tem um editor, tem um designer, e continua sendo quem decide o tema todo mês.</p></div>
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="magnifying-glass" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Seu concorrente aparece no YouTube quando alguém pesquisa o que você faz melhor que ele.</p></div>
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="eyeglasses" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Você quer aparecer, mas não quer virar influenciador nem dançar para o algoritmo.</p></div>
          <div class="p-6 rounded-xl border border-border shadow-card"><Icon name="chart-bar" class="text-3xl text-primary mb-4 block" /><p class="text-gray-800">Você quer olhar um número no fim do mês e entender o que fazer no mês seguinte.</p></div>
        </div>

        <div class="text-center">
          <button type="button" onclick="openModal()" class="inline-flex items-center justify-center bg-primary text-white font-semibold px-8 py-4 rounded-md hover:bg-primary/90 transition-colors text-lg">
            Quero ter um parceiro estratégico no YouTube
          </button>
        </div>
      </div>
    </Reveal>

    <!-- 07 · CASES COM NOME -->
    <Reveal as="section" class="py-16 md:py-24 bg-soft border-t border-border">
      <div class="max-w-6xl mx-auto px-6">
        <div class="mb-16">
          <div class="text-center mb-10">
            <h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase mb-4 text-foreground">Resultados que construímos na <span class="text-primary">prática</span></h2>
            <p class="text-gray-700 text-lg">Canais reais com crescimento validado pelo próprio YouTube Studio.</p>
          </div>

          <div class="grid lg:grid-cols-3 gap-8">
            <div class="flex flex-col items-center">
              <img src="/assets/case-1.webp" alt="Aumento de 1907% nas visualizações e 1527% na receita com otimização SEO Aprimarus" width="400" height="300" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full object-cover">
              <p class="mt-3 text-sm font-semibold text-foreground">Dr. Igor Steinmeyer · gestão para dentistas</p>
              <div class="mt-2 flex flex-wrap justify-center gap-2 w-full">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="trend-up" weight="bold" /> +1.907% Visualizações
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="currency-circle-dollar" weight="bold" /> +1.527% Receita
                </span>
              </div>
            </div>

            <div class="flex flex-col items-center">
              <img src="/assets/case-2.webp" alt="Estratégia de retenção no YouTube gerando aumento de 184% nas views - Aprimarus" width="400" height="300" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full object-cover">
              <p class="mt-3 text-sm font-semibold text-foreground">Carteira de saúde · autoridade e retenção</p>
              <div class="mt-2 flex flex-wrap justify-center gap-2 w-full">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="trend-up" weight="bold" /> +184% Visualizações
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="trend-up" weight="bold" /> +125% Retenção
                </span>
              </div>
            </div>

            <div class="flex flex-col items-center">
              <img src="/assets/case-3.webp" alt="Crescimento acelerado de 4480% em inscritos através de vídeos otimizados - Aprimarus" width="400" height="300" loading="lazy" decoding="async" class="rounded-xl shadow-card border border-border w-full object-cover">
              <p class="mt-3 text-sm font-semibold text-foreground">Canal começado do zero · efeito composto em 3 meses</p>
              <div class="mt-2 flex flex-wrap justify-center gap-2 w-full">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="trend-up" weight="bold" /> +390% Visualizações
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-growth-bg text-growth font-bold text-sm">
                  <Icon name="trend-up" weight="bold" /> +4.480% Inscritos
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- 08 · DEPOIMENTOS -->
        <div>
          <h2 class="font-display text-2xl sm:text-3xl uppercase mb-8 text-center text-foreground">O que nossos clientes dizem</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {depoimentos.map((d) => (
              <div class="bg-card rounded-xl border border-border shadow-card p-6 flex flex-col gap-4">
                <p class="font-display text-xl leading-snug text-foreground">&ldquo;{d.frase}&rdquo;</p>
                <div class="flex items-center gap-3 mt-auto pt-3 border-t border-border">
                  <img src={d.img} alt="Print da conversa original no WhatsApp" width="44" height="44" loading="lazy" decoding="async" class="w-11 h-11 rounded-lg object-cover border border-border" />
                  <span class="text-xs text-gray-500">{d.nome ?? 'Cliente Aprimarus'} · print da conversa</span>
                </div>
              </div>
            ))}
          </div>
          <div class="text-center mt-12">
            <a href="/portfolio" class="inline-flex items-center gap-2 font-semibold text-primary hover:text-primary/80 transition-colors border-b-2 border-primary pb-1">
              Ver portfólio completo e mais depoimentos <Icon name="arrow-right" weight="bold" />
            </a>
          </div>
        </div>
      </div>
    </Reveal>

    <!-- 09 · PROCESSO EM 6 PASSOS -->
    <Reveal as="section" class="py-16 md:py-24 bg-foreground text-background">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase mb-4">
            Você só grava.<br />
            <span class="font-bold underline decoration-primary underline-offset-4">Toda a pré e pós-produção</span> é com a gente.
          </h2>
          <p class="text-gray-300 mt-6 text-lg">Um processo validado em mais de 25 canais para transformar gravações brutas em crescimento real.</p>
        </div>

        <div class="space-y-8">
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">1</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Estruturação do Canal + Análise de Mercado</h3><p class="text-gray-300">Antes do primeiro vídeo, mapeamos seu nicho, concorrentes e pesquisas.</p></div>
          </div>
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">2</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Pesquisa de Temas + Gancho e Promessa</h3><p class="text-gray-300">Você recebe os temas do mês com ganchos prontos. Você só fala o seu conhecimento.</p></div>
          </div>
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">3</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Você Grava. Só Isso.</h3><p class="text-gray-300">Sem pensar em edição ou SEO. Você grava do seu jeito e manda o arquivo.</p></div>
          </div>
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">4</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Edição Profissional + Capa Otimizada</h3><p class="text-gray-300">Edição focada em retenção. Thumbnail criada para gerar o máximo de cliques.</p></div>
          </div>
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">5</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Postagem com SEO Completo</h3><p class="text-gray-300">Título, descrição, tags e cards preenchidos pro algoritmo encontrar seu vídeo.</p></div>
          </div>
          <div class="flex gap-5 items-start">
            <div class="w-14 h-14 shrink-0 rounded-lg bg-primary text-white font-display text-2xl flex items-center justify-center">6</div>
            <div><h3 class="font-bold text-xl mb-1 text-white">Relatório Mensal com Análise Real</h3><p class="text-gray-300">Todo mês ajustamos a estratégia com base em dados, não com achismo.</p></div>
          </div>
        </div>

        <div class="text-center mt-12">
          <button type="button" onclick="openModal()" class="inline-flex items-center justify-center bg-primary text-white font-semibold px-8 py-4 rounded-md hover:bg-primary/90 transition-colors text-lg">
            Quero esse processo no meu canal
          </button>
        </div>
      </div>
    </Reveal>

    <!-- 10 · PRIMEIROS 30 DIAS -->
    <Reveal as="section" class="py-16 md:py-24 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase mb-4">O que acontece <span class="text-primary">na primeira semana depois do sim</span></h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 mb-10">
          <div class="p-6 rounded-xl border border-border shadow-card">
            <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">Semana 1</p>
            <p class="text-gray-800">Diagnóstico do canal, mapa de quem já ganha as buscas do seu nicho, e a estrutura arrumada: nome, descrição, playlists e arte.</p>
          </div>
          <div class="p-6 rounded-xl border border-border shadow-card">
            <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">Semana 2</p>
            <p class="text-gray-800">Você recebe a primeira leva de temas com gancho e promessa prontos. Aprova, e grava na hora que der.</p>
          </div>
          <div class="p-6 rounded-xl border border-border shadow-card">
            <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">Semana 3</p>
            <p class="text-gray-800">Primeiros vídeos editados, com capa e SEO completo. A publicação começa.</p>
          </div>
          <div class="p-6 rounded-xl border border-border shadow-card">
            <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">Semana 4</p>
            <p class="text-gray-800">Primeiro relatório. O que rodou, o que não rodou, e o que muda no mês seguinte.</p>
          </div>
        </div>
        <p class="text-center text-gray-700 text-lg">Você não precisa aprender nada disso. Precisa gravar e aprovar.</p>
      </div>
    </Reveal>

    <!-- 12 · PLANOS -->
    <Reveal as="section" class="py-16 md:py-24 bg-soft border-t border-border">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl uppercase mb-5 text-foreground">
            Modelos de <span class="text-primary">Parceria</span>
          </h2>
          <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-growth-bg text-growth font-bold text-base sm:text-lg mb-5">
            <Icon name="tag" weight="bold" /> A partir de R$ 3.000/mês
          </span>
          <p class="text-gray-600 max-w-2xl mx-auto text-base">
            Qual plano serve para você depende da frequência que você consegue gravar, e a gente descobre isso em quinze minutos de conversa.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
          <div class="bg-card rounded-2xl p-8 border border-border shadow-card flex flex-col mt-4 md:mt-4">
            <h3 class="font-display text-2xl uppercase mb-1">Essencial</h3>
            <p class="text-gray-600 text-sm mb-6 h-10">Para quem quer começar com consistência</p>
            <ul class="space-y-4 mb-8 flex-1 text-sm text-gray-700">
              <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-0.5" /> 4 vídeos por mês (1x por semana)</li>
              <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-0.5" /> SEO completo em cada publicação</li>
              <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-0.5" /> Thumbnails otimizadas para clique</li>
              <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-0.5" /> Estruturação do canal</li>
              <li class="flex gap-3 items-start"><Icon name="check" weight="bold" class="text-primary mt-0.5" /> Relatório mensal e suporte</li>
            </ul>
            <button type="button" onclick="openModal()" class="w-full text-center border-2 border-gray-200 text-foreground font-semibold py-3.5 rounded-md hover:border-foreground transition-colors">
              Falar sobre o Essencial &rarr;
            </button>
          </div>

          <div class="bg-primary text-white rounded-2xl p-8 shadow-elegant flex flex-col relative transform md:-translate-y-4 border-2 border-primary">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-foreground text-white text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1 uppercase tracking-wider">
              <Icon name="star" weight="fill" /> Mais escolhido
            </div>
