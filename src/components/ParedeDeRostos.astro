---
import clientes from '../data/clientes.json';

const lista = clientes.filter((c) => c.foto && c.autorizado);
const rolar = lista.length >= 8;
const fila = rolar ? [...lista, ...lista] : lista;
---

<section class="py-16 md:py-20 bg-soft border-t border-border overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 text-center mb-10">
    <h2 class="font-display text-3xl sm:text-4xl uppercase mb-3">Quem já confiou o canal pra gente</h2>
    <p class="text-gray-700 max-w-2xl mx-auto">
      Médicos, dentistas, nutrólogos, psiquiatras e especialistas que decidiram parar de tentar sozinhos.
    </p>
  </div>

  {rolar ? (
    <div class="esteira-wrap esteira-mask">
      <ul class="esteira list-none p-0 m-0">
        {fila.map((c, i) => (
          <li class="flex flex-col items-center w-32 shrink-0" aria-hidden={i >= lista.length ? 'true' : undefined}>
            <img src={c.foto} alt={`${c.nome}, ${c.nicho}`} width="96" height="96" loading="lazy" decoding="async"
                 class="w-24 h-24 rounded-full object-cover border-2 border-white shadow-[0_1px_2px_rgba(23,18,19,.05),0_8px_24px_-8px_rgba(23,18,19,.12)] bg-soft" />
            <span class="mt-3 font-semibold text-sm text-center leading-tight">{c.nome}</span>
            <span class="text-xs text-gray-500 text-center leading-tight mt-0.5">{c.nicho}</span>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <ul class="max-w-5xl mx-auto px-6 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-8 list-none p-0">
      {lista.map((c) => (
        <li class="flex flex-col items-center">
          <img src={c.foto} alt={`${c.nome}, ${c.nicho}`} width="96" height="96" loading="lazy" decoding="async"
               class="w-24 h-24 rounded-full object-cover border-2 border-white shadow-[0_1px_2px_rgba(23,18,19,.05),0_8px_24px_-8px_rgba(23,18,19,.12)] bg-soft" />
          <span class="mt-3 font-semibold text-sm text-center leading-tight">{c.nome}</span>
          <span class="text-xs text-gray-500 text-center leading-tight mt-0.5">{c.nicho}</span>
        </li>
      ))}
    </ul>
  )}
</section>
