---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import IconSprite from '../components/IconSprite.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** JSON-LD adicional específico da página (ex: Article, FAQPage). Sempre inclui ProfessionalService. */
  extraSchema?: object[];
}

const {
  title,
  description,
  ogImage = 'https://aprimarus.com.br/assets/casal.webp',
  extraSchema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Aprimarus',
  url: 'https://aprimarus.com.br',
  logo: 'https://aprimarus.com.br/assets/casal.webp',
  image: 'https://aprimarus.com.br/assets/casal.webp',
  description: 'Agência especializada em SEO, edição avançada e gestão estratégica de canais no YouTube para infoprodutores e profissionais liberais.',
  telephone: '+5519991166155',
  founder: [
    { '@type': 'Person', name: 'Leonardo Di Bartolomeo', jobTitle: 'Especialista em SEO para YouTube e Edição de Vídeo' },
    { '@type': 'Person', name: 'Veronica Di Bartolomeo', jobTitle: 'Especialista em Estratégia de Conteúdo e Criação Visual' },
  ],
  areaServed: ['BR', 'AR'],
  availableLanguage: ['pt-BR', 'es'],
  knowsAbout: ['YouTube SEO', 'Edição de Vídeo', 'Marketing para Infoprodutores', 'Crescimento Orgânico no YouTube', 'Gestão de Tráfego Orgânico'],
  priceRange: '$$',
  sameAs: [
    'https://www.instagram.com/leodibarto/',
    'https://www.youtube.com/@leonardoseoyoutube',
    'https://www.tiktok.com/@leonardo.seoyoutube',
    'https://www.linkedin.com/company/144741992',
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Aprimarus" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- OPEN GRAPH -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />

    <!-- TWITTER -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SCHEMA.ORG -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {extraSchema.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- PRECONNECTS E FONTES (carregamento assíncrono para não bloquear a renderização) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;600;700&display=swap" />
    </noscript>

    <!-- Ícones: sprite SVG inline próprio (public/icons-sprite.svg), servido do mesmo domínio.
         Substitui as 3 folhas de estilo do Phosphor via CDN (regular/bold/fill), que eram ~36KB
         de CSS quase todo não usado mais 3 arquivos de fonte bloqueando o render. -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog da Aprimarus" href="/blog/rss.xml" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <IconSprite />
    <Nav />

    <slot />

    <Footer />
    <LeadModal />

    <!-- Google Tag Manager: carregado depois que a página fica ociosa (requestIdleCallback),
         pra não competir pelo thread principal com o primeiro parse/pintura. GTM continua
         disparando o page_view normalmente, só adia a inicialização em geral menos de 1s. -->
    <script is:inline>
      function bootGTM() {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-KK5V6447');
      }
      document.addEventListener('DOMContentLoaded', function () {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(bootGTM, { timeout: 2000 });
        } else {
          setTimeout(bootGTM, 200);
        }
      });
    </script>
    <!-- End Google Tag Manager -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KK5V6447"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <script is:inline>
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
